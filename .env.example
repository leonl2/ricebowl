# Copy this file to .env and fill in your keys
# cp .env.example .env

# ARC-AGI-3 API Key - get one free at https://three.arcprize.org
# Optional - only needed for online scorecards/replays
ARC_API_KEY=your_arc_api_key_here

# Anthropic API Key - only needed for claude/claudefast/claudeopus agents
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local LLM settings - for local/localfast/hybrid agents
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:32b-instruct
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_USE_TOOLS=true

# Recordings directory
RECORDINGS_DIR=recordings

# Set to True for online-only mode (API only, no local environments)
ONLINE_ONLY=False
