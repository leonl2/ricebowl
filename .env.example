# Copy this file to .env and fill in your keys
# cp .env.example .env

# ARC-AGI-3 API Key - get one at https://three.arcprize.org
ARC_API_KEY=your_arc_api_key_here

# Anthropic API Key - for Claude-powered agent
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Recordings directory
RECORDINGS_DIR=recordings

# Set to True for online-only mode (API only, no local environments)
ONLINE_ONLY=False
